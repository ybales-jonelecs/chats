rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(members) {
      return signedIn() && request.auth.uid in members;
    }

    // Every signed-in user can discover registered users.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update, delete: if signedIn() && request.auth.uid == uid;
    }

    // One friendship document represents the friendship for both users.
    // Document ID is the sorted pair of UIDs: uidA_uidB
    match /friendships/{friendshipId} {
      allow read: if isMember(resource.data.members);

      allow create: if isMember(request.resource.data.members)
        && request.resource.data.members.size() == 2;

      allow delete: if isMember(resource.data.members);
    }

    // Conversation parent document stores its two members.
    match /conversations/{conversationId} {
      allow read: if isMember(resource.data.members);

      allow create: if isMember(request.resource.data.members)
        && request.resource.data.members.size() == 2;

      allow update: if isMember(resource.data.members)
        && request.resource.data.members == resource.data.members;

      match /messages/{messageId} {
        allow read: if isMember(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
        );

        allow create: if isMember(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
        ) && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
